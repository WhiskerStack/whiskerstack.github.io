---
/**
 * Portada: los trabajos destacados apilados como hojas (una "stack").
 * La de delante se abre en una pestaña nueva; tocar una de atrás la trae al frente.
 */
import { Image } from "astro:assets";
import { featured, shotFor, hostOf } from "../lib/projects";
const n = featured.length;
---
{n > 0 && (
  <div class="stack" data-stack style={`--n:${n}`}>
    <div class="deck">
      {featured.map((p, i) => {
        const shot = shotFor(p.slug);
        return (
          <a
            class="sheet"
            href={p.url}
            target="_blank"
            rel="noopener"
            data-i={i}
            data-pos={i}
            data-name={p.name}
            data-kind={p.kind}
            data-desc={p.description}
            tabindex={i === 0 ? 0 : -1}
            aria-hidden={i === 0 ? undefined : "true"}
          >
            <span class="chrome" aria-hidden="true">
              <span class="url">{hostOf(p.url)}</span>
            </span>
            {shot ? (
              <Image
                src={shot}
                alt={`Portada de ${p.name}, ${p.kind.toLowerCase()}`}
                widths={[480, 760, 1280]}
                sizes="(max-width: 960px) 92vw, 560px"
                loading={i === 0 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : undefined}
              />
            ) : (
              <span class="noshot">{p.name}</span>
            )}
          </a>
        );
      })}
    </div>

    <div class="caption">
      <div class="info" aria-live="polite">
        <p class="kind mute" data-f="kind">{featured[0].kind}</p>
        <p class="title" data-f="name">{featured[0].name}</p>
        <p class="desc mute" data-f="desc">{featured[0].description}</p>
      </div>
      <div class="row">
        <a class="visit" data-f="url" href={featured[0].url} target="_blank" rel="noopener">Visitar el sitio</a>
        {n > 1 && (
          <div class="picks" role="group" aria-label="Elegir trabajo">
            {featured.map((p, i) => (
              <button type="button" class="pick" data-i={i} aria-pressed={i === 0 ? "true" : "false"}>
                <span class="sr-only">{p.name}</span>
              </button>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
)}

<style>
  .stack {
    width: 100%;
    max-width: 560px;
    display: grid;
    gap: 1.6rem;
  }
  .deck {
    position: relative;
    display: grid;
    /* espacio para las hojas de atrás, que asoman por arriba */
    padding-top: calc(min(var(--n) - 1, 4) * 4.5%);
  }
  .sheet {
    grid-area: 1 / 1;
    display: block;
    border-radius: 16px;
    overflow: hidden;
    border: 2px solid var(--fg);
    background: var(--fg);
    color: var(--bg);
    text-decoration: none;
    transform-origin: 50% 100%;
    transition:
      transform 0.55s cubic-bezier(0.5, 0, 0.15, 1),
      filter 0.55s;
    will-change: transform;
  }
  .sheet[data-pos="0"] { z-index: 5; transform: none; }
  .sheet[data-pos="1"] { z-index: 4; transform: translate(-3%, -6%) rotate(-3deg) scale(0.96); filter: brightness(0.9); }
  .sheet[data-pos="2"] { z-index: 3; transform: translate(4%, -10%) rotate(3.5deg) scale(0.92); filter: brightness(0.82); }
  .sheet[data-pos="3"] { z-index: 2; transform: translate(-6%, -13%) rotate(-5deg) scale(0.88); filter: brightness(0.75); }
  .sheet[data-pos="4"] { z-index: 1; transform: translate(7%, -16%) rotate(5.5deg) scale(0.84); filter: brightness(0.7); }
  .sheet:not([data-pos="0"]) {
    cursor: pointer;
  }
  .sheet:not([data-pos="0"]):hover {
    filter: brightness(1);
  }
  @starting-style {
    .sheet {
      transform: none;
    }
  }
  .chrome {
    display: flex;
    align-items: center;
    height: 34px;
    padding-inline: 10px;
  }
  .url {
    flex: 1;
    font-size: 0.78rem;
    line-height: 22px;
    padding-inline: 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 14%, var(--fg));
    color: color-mix(in srgb, var(--bg) 80%, var(--fg));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sheet :global(img),
  .noshot {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }
  .noshot {
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 1.6rem;
  }

  .caption {
    display: grid;
    gap: 1rem;
  }
  .info {
    display: grid;
    gap: 0.25rem;
    min-height: 7.2rem;
  }
  .kind {
    font-size: 0.95rem;
  }
  .title {
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
  }
  .desc {
    font-size: 1rem;
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .visit {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }
  .picks {
    display: flex;
    gap: 0.5rem;
  }
  .pick {
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .pick::before {
    content: "";
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--fg);
    transition: width 0.3s, background-color 0.3s;
  }
  .pick[aria-pressed="true"]::before {
    width: 28px;
    border-radius: 999px;
    background: var(--fg);
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet {
      transition: none;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-stack]")) {
    const sheets = [...root.querySelectorAll<HTMLAnchorElement>(".sheet")];
    const picks = [...root.querySelectorAll<HTMLButtonElement>(".pick")];
    const field = (f: string) => root.querySelector<HTMLElement>(`[data-f="${f}"]`)!;
    const n = sheets.length;
    let active = 0;

    const show = (i: number) => {
      active = (i + n) % n;
      sheets.forEach((s, k) => {
        const pos = (k - active + n) % n;
        s.dataset.pos = String(pos);
        s.tabIndex = pos === 0 ? 0 : -1;
        if (pos === 0) s.removeAttribute("aria-hidden");
        else s.setAttribute("aria-hidden", "true");
      });
      picks.forEach((p, k) => p.setAttribute("aria-pressed", String(k === active)));
      const s = sheets[active];
      field("kind").textContent = s.dataset.kind!;
      field("name").textContent = s.dataset.name!;
      field("desc").textContent = s.dataset.desc!;
      (field("url") as HTMLAnchorElement).href = s.href;
    };

    sheets.forEach((s, k) =>
      s.addEventListener("click", (e) => {
        if (k !== active) {
          e.preventDefault();
          show(k);
        }
      }),
    );
    picks.forEach((p, k) => p.addEventListener("click", () => show(k)));
    root.addEventListener("keydown", (e) => {
      if (n < 2) return;
      if (e.key === "ArrowRight") show(active + 1);
      else if (e.key === "ArrowLeft") show(active - 1);
      else return;
      picks[active]?.focus();
    });
  }
</script>
