---
import Logo from "./Logo.astro";
import { whatsappLink } from "../config/site";
---
<section id="contacto" class="contact inv" aria-labelledby="contacto-title">
  <div class="wrap contact-grid">
    <div>
      <h2 id="contacto-title">Cuéntanos qué quieres publicar.</h2>
      <p class="lede mute">Escríbenos por WhatsApp. Con saber qué vendes o informas y cuántos productos tienes, te damos una idea del trabajo.</p>
      <div class="cta-row">
        <a class="btn" href={whatsappLink("Hola, quiero cotizar un sitio web.")}>WhatsApp</a>
      </div>
    </div>
    <Logo class="contact-mark" />
  </div>
</section>

<style>
  .contact {
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .contact-grid > div {
    display: grid;
    gap: 1.4rem;
  }
  .contact .mute {
    color: color-mix(in srgb, var(--fg) 72%, var(--bg));
  }
  .contact :global(.contact-mark) {
    width: 100%;
    max-width: 300px;
    height: auto;
    justify-self: end;
  }
  @media (max-width: 960px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .contact :global(.contact-mark) {
      max-width: 160px;
      justify-self: start;
      order: -1;
    }
  }
</style>
